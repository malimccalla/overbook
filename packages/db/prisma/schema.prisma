generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id         String   @id @default(cuid())
  clerkOrgId String?  @unique @map("clerk_org_id")
  name       String
  slug       String   @unique
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  memberships      Membership[]
  connectedInboxes ConnectedInbox[]
  artists          Artist[]
  rawEmails        RawEmail[]
  bookingRequests  BookingRequest[]
  bookings         Booking[]

  @@map("organizations")
}

enum MemberRole {
  OWNER
  ADMIN
  AGENT
  ASSISTANT

  @@map("member_role")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique @map("clerk_id")
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships        Membership[]
  connectedInboxes   ConnectedInbox[]
  artistsRepresented Artist[]         @relation("AgentArtists")
  forwardedRequests  BookingRequest[] @relation("ForwardedRequests")
  assignedRequests   BookingRequest[] @relation("AssignedRequests")

  @@map("users")
}

model Membership {
  id             String     @id @default(cuid())
  role           MemberRole @default(AGENT)
  organizationId String     @map("organization_id")
  userId         String     @map("user_id")
  createdAt      DateTime   @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("memberships")
}

model Artist {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  agentId         String?  @map("agent_id")
  name            String
  aliases         String[]
  genres          String[]
  notes           String?
  nylasCalendarId String?  @map("nylas_calendar_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent           User?            @relation("AgentArtists", fields: [agentId], references: [id])
  bookingRequests BookingRequest[]
  bookings        Booking[]

  @@index([organizationId])
  @@map("artists")
}

model ConnectedInbox {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  email          String
  displayName    String?  @map("display_name")
  userId         String?  @map("user_id")
  nylasGrantId   String?  @unique @map("nylas_grant_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])
  rawEmails    RawEmail[]

  @@unique([organizationId, email])
  @@map("connected_inboxes")
}

model RawEmail {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  connectedInboxId String   @map("connected_inbox_id")
  nylasMessageId   String   @unique @map("nylas_message_id")
  subject          String?
  bodyText         String   @db.Text @map("body_text")
  bodyHtml         String?  @db.Text @map("body_html")
  fromEmail        String?  @map("from_email")
  fromName         String?  @map("from_name")
  receivedAt       DateTime @map("received_at")
  hasAttachments   Boolean  @default(false) @map("has_attachments")
  createdAt        DateTime @default(now()) @map("created_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedInbox ConnectedInbox  @relation(fields: [connectedInboxId], references: [id])
  bookingRequest BookingRequest?

  @@index([organizationId])
  @@index([connectedInboxId])
  @@map("raw_emails")
}

enum BookingRequestSource {
  EMAIL
  MANUAL_PASTE
  API

  @@map("booking_request_source")
}

enum BookingRequestStatus {
  NEEDS_REVIEW
  DISMISSED
  INFO_REQUESTED
  CAPTURED

  @@map("booking_request_status")
}

model BookingRequest {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  artistId       String?              @map("artist_id")
  rawEmailId     String?              @unique @map("raw_email_id")
  forwardedById  String?              @map("forwarded_by_id")
  assignedToId   String?              @map("assigned_to_id")

  promoter        String?
  promoterEmail   String?  @map("promoter_email")
  venue           String?
  city            String?
  country         String?
  proposedDate    DateTime? @map("proposed_date")
  proposedDateRaw String?   @map("proposed_date_raw")

  feeAmount      Int?     @map("fee_amount")
  feeMin         Int?     @map("fee_min")
  feeMax         Int?     @map("fee_max")
  feeIsRange     Boolean  @default(false) @map("fee_is_range")
  currencyCode   String?  @map("currency_code")
  currencySymbol String?  @map("currency_symbol")
  rawFee         String?  @map("raw_fee")

  agencyFeeOnTop Boolean? @map("agency_fee_on_top")

  source  BookingRequestSource @default(API)
  details Json?

  status                BookingRequestStatus @default(NEEDS_REVIEW)
  confidence            Float?
  missingFields         String[]             @map("missing_fields")
  conflictFlags         String[]             @map("conflict_flags")
  summary               String?
  notes                 String?
  recommendedNextAction String?              @map("recommended_next_action")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  artist       Artist?      @relation(fields: [artistId], references: [id])
  rawEmail     RawEmail?    @relation(fields: [rawEmailId], references: [id])
  forwardedBy  User?        @relation("ForwardedRequests", fields: [forwardedById], references: [id])
  assignedTo   User?        @relation("AssignedRequests", fields: [assignedToId], references: [id])
  booking      Booking?

  @@index([organizationId])
  @@index([artistId])
  @@index([status])
  @@map("booking_requests")
}

enum BookingStatus {
  CAPTURED
  AWAITING_REPLY
  IN_NEGOTIATION
  PENCILLED
  AWAITING_ARTIST
  AWAITING_PROMOTER
  CONTRACT_REQUESTED
  CONTRACT_RECEIVED
  CONFIRMED
  LOST

  @@map("booking_status")
}

model Booking {
  id               String        @id @default(cuid())
  organizationId   String        @map("organization_id")
  artistId         String        @map("artist_id")
  bookingRequestId String        @unique @map("booking_request_id")

  promoter       String?
  venue          String?
  city           String?
  country        String?
  date           DateTime?
  feeAmount      Int?          @map("fee_amount")
  currencyCode   String?       @map("currency_code")
  currencySymbol String?       @map("currency_symbol")
  agencyFeeOnTop Boolean?      @map("agency_fee_on_top")
  status         BookingStatus @default(CAPTURED)
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  artist         Artist         @relation(fields: [artistId], references: [id])
  bookingRequest BookingRequest @relation(fields: [bookingRequestId], references: [id])

  @@index([organizationId])
  @@index([artistId])
  @@index([status])
  @@map("bookings")
}
